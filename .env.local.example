# Supabase Project Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# YouTube Data API & Sync Configuration
YT_API_KEY=your-youtube-data-api-key
YT_PLAYLIST_ID=your-youtube-playlist-id
SYNC_SECRET=your-sync-secret-key

# Owner / Admin Configuration
ADMIN_EMAIL=your-admin-email@example.com

# Resend Email API (get free key at https://resend.com)
RESEND_API_KEY=re_your_resend_api_key

# Site URL (used in approval email links)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Neon Database Connection
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# YouTube OAuth 2.0 (for toggling video privacy)
YT_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
YT_OAUTH_CLIENT_SECRET=your-client-secret
YT_OAUTH_REFRESH_TOKEN=your-refresh-token
